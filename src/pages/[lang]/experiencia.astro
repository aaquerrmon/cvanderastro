---
import MainLayout from '../../layouts/MainLayout.astro';
import ExperienceCard from '../../components/ExperienceCard.astro';
import { useTranslation, type Language } from '../../i18n/config';

const lang: Language = Astro.params.lang === 'en' ? 'en' : 'es';
const t = useTranslation(lang);

const experiencia = (await import('../../data/experiencia.json')).default;
const experienciaData = experiencia[lang];
---

<MainLayout lang={lang} title={`${t('nav.experience')} - Ander Aquerreta`}>
	<section class="py-28 px-4">
		<div class="max-w-4xl mx-auto">
			<div class="text-center mb-16">
				<h1 class="section-title gradient-text">{t('experience.title')}</h1>
				<div class="glow-line"></div>
				<p class="section-subtitle">{t('experience.description')}</p>
			</div>

			{experienciaData.length > 0 ? (
				<div class="space-y-6">
					{experienciaData.map((exp) => (
						<ExperienceCard experience={exp} lang={lang} />
					))}
				</div>
			) : (
				<div class="text-center py-12">
					<p class="text-slate-500">{t('experience.noExperience')}</p>
				</div>
			)}
		</div>
	</section>
</MainLayout>
