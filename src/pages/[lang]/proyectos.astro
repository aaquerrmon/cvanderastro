---
import MainLayout from '../../layouts/MainLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { useTranslation, type Language } from '../../i18n/config';
import { type Project } from '../../types';

const lang: Language = Astro.params.lang === 'en' ? 'en' : 'es';
const t = useTranslation(lang);

const proyectos = await fetch('https://api.github.com/users/aaquerrmon/repos?sort=updated', {
  headers: {
    'Authorization': `Bearer ${import.meta.env.GITHUB_TOKEN}`,
    'Accept': 'application/vnd.github.v3+json'
  }
});
const proyectosRaw = await proyectos.json();

// 1. Safe guard: Ensure proyectosRaw is actually an array, default to empty array if not
const rawArray = Array.isArray(proyectosRaw) ? proyectosRaw : [];

// 2. Optional: Log a warning if it's not an array so you can debug the API response
if (!Array.isArray(proyectosRaw)) {
  console.warn("⚠️ proyectosRaw is not an array! Received:", proyectosRaw);
}

// Mapear solo los campos que necesitas de la respuesta de GitHub
// Filtrar solo proyectos que NO son forked
const proyectosData: Project[] = rawArray
  .filter((repo: any) => !repo.fork)
  .map((repo: any) => ({
    id: repo.id,
    fullname: repo.name,
    description: repo.description || 'No description',
    html_url: repo.html_url,
    private: repo.private,
    language: repo.language ? [repo.language] : ['Unknown'],
    bannerImage: `https://raw.githubusercontent.com/${repo.full_name}/main/banner.png`
  }));

export async function getStaticPaths() {
	return [
		{ params: { lang: 'es' } },
		{ params: { lang: 'en' } }
	];
}
---

<MainLayout lang={lang} title={`${t('nav.projects')} - Ander Aquerreta`}>
	<section class="py-20 px-4">
		<div class="max-w-5xl mx-auto">
			<div class="mb-12">
				<h1 class="text-5xl font-bold mb-4">{t('projects.title')}</h1>
				<p class="text-lg text-slate-600 dark:text-slate-400">{t('projects.description')}</p>
			</div>

			{proyectosData.length > 0 ? (
				<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
					{proyectosData.map((project) => (
						<ProjectCard project={project} lang={lang} />
					))}
				</div>
			) : (
				<div class="text-center py-12">
					<p class="text-slate-600 dark:text-slate-400">{t('projects.noProjects')}</p>
				</div>
			)}
		</div>
	</section>
</MainLayout>
