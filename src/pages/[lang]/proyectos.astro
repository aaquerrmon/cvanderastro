---
import MainLayout from '../../layouts/MainLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { useTranslation, type Language } from '../../i18n/config';
import { type Project } from '../../types';
import { env } from 'cloudflare:workers';

const lang: Language = Astro.params.lang === 'en' ? 'en' : 'es';
const t = useTranslation(lang);

const proyectos = (await import('../../data/proyectos.json')).default;
const proyectosLocal = proyectos[lang];

let rawArray: any[] = [];

try {
  const token = env?.GITHUB_TOKEN || import.meta.env.GITHUB_TOKEN;

  if (token) {
    const response = await fetch('https://api.github.com/users/aaquerrmon/repos?sort=updated', {
      headers: {
        'Authorization': `Bearer ${token}`,
        'Accept': 'application/vnd.github.v3+json',
        'User-Agent': 'Mozilla/5.0 (Compatible; Astro)'
      }
    });

    if (response.ok) {
      const proyectosRaw = await response.json();
      rawArray = Array.isArray(proyectosRaw) ? proyectosRaw : [];
    }
  }
} catch (error) {
  console.error("Error fetching GitHub repos:", error);
}

const githubProjects: Project[] = rawArray
  .filter((repo: any) => !repo.fork)
  .map((repo: any) => ({
    id: repo.id,
    fullname: repo.name,
    description: repo.description || 'No description',
    html_url: repo.html_url,
    private: repo.private,
    language: repo.language ? [repo.language] : ['Unknown'],
    bannerImage: `https://raw.githubusercontent.com/${repo.full_name}/main/banner.png`
  }));

const allProjects = [
  ...proyectosLocal.map((p) => ({
    id: p.id,
    fullname: p.title,
    description: p.description,
    html_url: p.link,
    private: false,
    language: p.technologies,
  })),
  ...githubProjects,
];
---

<MainLayout lang={lang} title={`${t('nav.projects')} - Ander Aquerreta`}>
	<section class="py-28 px-4">
		<div class="max-w-5xl mx-auto">
			<div class="text-center mb-16">
				<h1 class="section-title gradient-text">{t('projects.title')}</h1>
				<div class="glow-line"></div>
				<p class="section-subtitle">{t('projects.description')}</p>
			</div>

			{githubProjects.length > 0 ? (
				<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
					{githubProjects.map((project) => (
						<ProjectCard project={project} lang={lang} />
					))}
				</div>
			) : (
				<div class="text-center py-12">
					<div class="glass-card p-12 max-w-md mx-auto">
						<p class="text-slate-500 font-mono text-sm">{t('projects.noProjects')}</p>
					</div>
				</div>
			)}
		</div>
	</section>
</MainLayout>
