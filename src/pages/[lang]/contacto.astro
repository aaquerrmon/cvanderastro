---
import MainLayout from '../../layouts/MainLayout.astro';
import { useTranslation, defaultLanguage, type Language } from '../../i18n/config';

const lang: Language = Astro.params.lang === 'en' ? 'en' : 'es';
const t = useTranslation(lang);

const cv = (await import('../../data/cv.json')).default;
const cvData = cv[lang];
---

<MainLayout lang={lang} title={`${t('nav.contact')} - Ander Aquerreta`}>
	<section class="py-28 px-4">
		<div class="max-w-3xl mx-auto">
			<div class="text-center mb-16">
				<h1 class="section-title gradient-text">{t('contact.title')}</h1>
				<div class="glow-line"></div>
				<p class="section-subtitle">{t('contact.description')}</p>
			</div>

			<div class="max-w-xl mx-auto space-y-6">
				<!-- Email -->
				<a href={`mailto:${cvData.email}`} class="glass-card-hover p-6 flex items-center gap-5 group block">
					<div class="w-12 h-12 rounded-xl bg-gradient-to-br from-cyan-500 to-emerald-500 flex items-center justify-center text-white shrink-0 group-hover:scale-110 transition-transform">
						<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
					</div>
					<div>
						<p class="text-xs font-mono text-slate-500 mb-0.5">{lang === 'es' ? 'Email' : 'Email'}</p>
						<p class="text-base text-slate-200 group-hover:text-cyan-400 transition font-medium">{cvData.email}</p>
					</div>
				</a>

				<!-- Location -->
				<div class="glass-card-hover p-6 flex items-center gap-5">
					<div class="w-12 h-12 rounded-xl bg-gradient-to-br from-emerald-500 to-green-500 flex items-center justify-center text-white shrink-0">
						<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
					</div>
					<div>
						<p class="text-xs font-mono text-slate-500 mb-0.5">{lang === 'es' ? 'Ubicación' : 'Location'}</p>
						<p class="text-base text-slate-200 font-medium">{cvData.location}</p>
					</div>
				</div>

				<!-- Social -->
				<div class="glass-card-hover p-6 flex items-center gap-5">
					<div class="w-12 h-12 rounded-xl bg-gradient-to-br from-purple-500 to-pink-500 flex items-center justify-center text-white shrink-0">
						<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
					</div>
					<div>
						<p class="text-xs font-mono text-slate-500 mb-2">{lang === 'es' ? 'Redes Sociales' : 'Social Media'}</p>
						<div class="flex gap-3">
							<a href={cvData.social.github} target="_blank" rel="noopener noreferrer" class="px-4 py-2 text-sm rounded-lg bg-slate-800/50 border border-slate-700/50 text-slate-300 hover:border-cyan-500/50 hover:text-cyan-400 transition font-medium">
								GitHub
							</a>
							<a href={cvData.social.linkedin} target="_blank" rel="noopener noreferrer" class="px-4 py-2 text-sm rounded-lg bg-gradient-to-r from-cyan-500/20 to-emerald-500/20 border border-cyan-500/30 text-cyan-300 hover:bg-cyan-500/30 transition font-medium">
								LinkedIn
							</a>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
</MainLayout>
