---
import { type LinkedInPost } from '../types';

interface Props {
  post: LinkedInPost;
}

const { post } = Astro.props;

const formatDate = (dateStr: string) => {
  const [year, month] = dateStr.split('-');
  const date = new Date(parseInt(year), parseInt(month) - 1);
  return date.toLocaleDateString('es-ES', { month: 'long', year: 'numeric' });
};
---

<div class="bg-white dark:bg-slate-800 rounded-lg shadow-lg overflow-hidden hover:shadow-xl transition-shadow">
  <img src={post.image} alt="Post" class="w-full aspect-video object-cover" />
  
  <div class="p-6">
    <p class="text-sm text-slate-500 dark:text-slate-400 mb-3">{formatDate(post.date)}</p>
    <p class="text-slate-700 dark:text-slate-300 mb-4 line-clamp-4">{post.content}</p>
    
    <div class="flex items-center gap-4 text-sm text-slate-600 dark:text-slate-400 pt-4 border-t border-slate-200 dark:border-slate-700">
      <span class="flex items-center gap-1">
        <span>👍</span>
        <span>{post.likes}</span>
      </span>
      <span class="flex items-center gap-1">
        <span>💬</span>
        <span>{post.comments}</span>
      </span>
      <span class="flex items-center gap-1">
        <span>↗</span>
        <span>{post.shares}</span>
      </span>
    </div>
  </div>
</div>
