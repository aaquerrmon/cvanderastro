---
import { type Education} from '../types';
import { type Language } from '../i18n/config';

interface Props {
  education: Education;
  lang: Language;
}

const { education, lang } = Astro.props;
---

<div class="bg-white dark:bg-slate-800 rounded-lg shadow-lg p-6 hover:shadow-xl transition-shadow">
  <div class="mb-4">
    <h3 class="text-xl font-bold text-slate-900 dark:text-white">{education.degree}</h3>
    <p class="text-sky-600 dark:text-cyan-400 font-medium">{education.field}</p>
    <p class="text-slate-600 dark:text-slate-400 text-sm">{education.institution}</p>
  </div>

  <div class="text-sm text-slate-600 dark:text-slate-400 mb-4">
    {education.startDate.split('-')[0]} - {education.endDate.split('-')[0]}
  </div>

  <p class="text-slate-700 dark:text-slate-300 mb-4">{education.description}</p>

  <div class="space-y-2">
    {education.highlights.map((highlight) => (
      <div class="flex items-start gap-2">
        <span class="text-sky-600 dark:text-cyan-400 mt-1">✓</span>
        <span class="text-slate-700 dark:text-slate-300">{highlight}</span>
      </div>
    ))}
  </div>
</div>
