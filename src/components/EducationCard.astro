---
import { type Education} from '../types';
import { type Language } from '../i18n/config';

interface Props {
  education: Education;
  lang: Language;
}

const { education, lang } = Astro.props;
---

<div class="glass-card-hover p-6 group">
  <div class="flex items-start gap-4">
    <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-cyan-500/20 to-purple-500/20 border border-cyan-500/20 flex items-center justify-center text-cyan-400 shrink-0 group-hover:scale-110 transition-transform">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 14l9-5-9-5-9 5 9 5z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"/></svg>
    </div>

    <div class="flex-1 min-w-0">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 mb-2">
        <h3 class="text-lg font-bold text-slate-200 group-hover:text-cyan-300 transition-colors">{education.degree}</h3>
        <span class="text-xs font-mono text-slate-500 shrink-0">
          {education.startDate.split('-')[0]} — {education.endDate.split('-')[0]}
        </span>
      </div>
      <p class="text-sm text-cyan-400 mb-1">{education.field}</p>
      <p class="text-xs text-slate-500 mb-3">
        <a
        href={education.url}
        target="_blank"
        rel="noopener noreferrer"
        >
        {education.institution}
        </a>
      </p>
      <p class="text-sm text-slate-400 leading-relaxed mb-3">{education.description}</p>

      <div class="space-y-1.5">
        {education.highlights.map((highlight) => (
          <div class="flex items-start gap-2 text-sm">
            <svg class="w-4 h-4 text-emerald-500 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <span class="text-slate-400">{highlight}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</div>
