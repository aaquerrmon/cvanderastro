---
import { type LinkedInPost } from '../types';

interface Props {
  post: LinkedInPost;
}

const { post } = Astro.props;

const formatDate = (dateStr: string) => {
  const [year, month] = dateStr.split('-');
  const date = new Date(parseInt(year), parseInt(month) - 1);
  return date.toLocaleDateString('es-ES', { month: 'long', year: 'numeric' });
};
---

<div class="glass-card-hover p-6 flex flex-col h-full">
  <div class="flex items-center gap-3 mb-4">
    <div class="w-10 h-10 rounded-full bg-gradient-to-br from-cyan-500 to-purple-500 flex items-center justify-center text-white text-sm font-bold shrink-0">
      {post.id}
    </div>
    <div class="flex-1 min-w-0">
      <p class="text-sm font-medium text-slate-300 truncate">
        {post.content.split('.')[0]}
      </p>
      <p class="text-xs text-slate-600 font-mono">{formatDate(post.date)}</p>
    </div>
  </div>

  <p class="text-sm text-slate-400 leading-relaxed flex-1 line-clamp-5">
    {post.content}
  </p>

  <div class="flex items-center gap-4 mt-4 pt-4 border-t border-slate-800/50 text-xs text-slate-600">
    <span class="flex items-center gap-1.5">
      <svg class="w-3.5 h-3.5 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
      {post.likes}
    </span>
    <span class="flex items-center gap-1.5">
      <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
      {post.comments}
    </span>
    <span class="flex items-center gap-1.5">
      <svg class="w-3.5 h-3.5 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/></svg>
      {post.shares}
    </span>
  </div>
</div>
