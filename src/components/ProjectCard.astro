---
import { type Project } from '../types';
import { type Language } from '../i18n/config';
  
interface Props {
  project: Project;
  lang: Language;
}

const { project, lang } = Astro.props;
console.log('ProjectCard received project:', project);
---

<div class="bg-white dark:bg-slate-800 rounded-lg shadow-lg overflow-hidden hover:shadow-xl transition-shadow h-full flex flex-col">
  <div 
    class="aspect-video bg-gradient-to-br from-sky-500 via-emerald-500 to-cyan-500 flex items-center justify-center text-white text-2xl font-bold bg-cover bg-center relative"
    style={project.bannerImage ? `background-image: url('${project.bannerImage}')` : ''}
  >
    {project.bannerImage && <div class="absolute inset-0 bg-black/30"></div>}
    <h2 class="relative z-10">{project.fullname}</h2>
  </div>

  <div class="p-6 flex-1 flex flex-col">
    <div class="flex items-center justify-between mb-2">
      <h3 class="text-xl font-bold text-slate-900 dark:text-white">{project.fullname}</h3>
      <span class="text-sm bg-yellow-100 dark:bg-yellow-900 text-yellow-800 dark:text-yellow-200 px-3 py-1 rounded">
          {project.private ? 'Private' : 'Public'}
      </span>
    </div>

    <p class="text-slate-700 dark:text-slate-300 mb-4 flex-1">{project.description}</p>

    <div class="flex flex-wrap gap-2 mb-4">
      {project.language.map((tech) => (
        <span class="text-xs bg-purple-100 dark:bg-purple-900 text-purple-800 dark:text-purple-200 px-2 py-1 rounded">
          {tech}
        </span>
      ))}
    </div>

    {project.html_url !== '#' && (
      <a href={project.html_url} target="_blank" rel="noopener noreferrer" class="text-sky-600 dark:text-cyan-400 hover:underline text-sm font-medium">
        {lang === 'es' ? 'Ver más →' : 'View more →'}
      </a>
    )}
  </div>
</div>
