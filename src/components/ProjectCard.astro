---
import { type Project } from '../types';
import { type Language } from '../i18n/config';

interface Props {
  project: Project;
  lang: Language;
}

const { project, lang } = Astro.props;
---

<div class="glass-card-hover overflow-hidden h-full flex flex-col group">
  <div
    class="aspect-video bg-gradient-to-br from-cyan-600/30 via-emerald-600/30 to-cyan-600/30 flex items-center justify-center text-white text-xl font-bold bg-cover bg-center relative border-b border-slate-800/50"
    style={project.bannerImage ? `background-image: url('${project.bannerImage}')` : ''}
  >
    {project.bannerImage && <div class="absolute inset-0 bg-[#0a0a0f]/40"></div>}
    <div class="relative z-10 text-center px-4">
      <svg class="w-10 h-10 mx-auto mb-2 text-cyan-400/60" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/></svg>
      <span class="font-mono text-sm text-slate-400 truncate block">{project.fullname}</span>
    </div>
  </div>

  <div class="p-5 flex-1 flex flex-col">
    <div class="flex items-center justify-between mb-3">
      <h3 class="text-base font-bold text-slate-200 group-hover:text-cyan-300 transition-colors truncate">{project.fullname}</h3>
      <span class={`text-[10px] font-mono px-2 py-0.5 rounded-full border ${project.private ? 'bg-yellow-500/10 border-yellow-500/30 text-yellow-400' : 'bg-emerald-500/10 border-emerald-500/30 text-emerald-400'}`}>
        {project.private ? 'Private' : 'Public'}
      </span>
    </div>

    <p class="text-sm text-slate-500 mb-4 flex-1 line-clamp-2 leading-relaxed">{project.description}</p>

    <div class="flex flex-wrap gap-1.5 mb-4">
      {project.language.map((tech) => (
        <span class="tech-tag">{tech}</span>
      ))}
    </div>

    {project.html_url !== '#' && (
      <a href={project.html_url} target="_blank" rel="noopener noreferrer" class="text-xs font-mono text-cyan-400 hover:text-cyan-300 transition flex items-center gap-1.5 group/link">
        <span>{lang === 'es' ? 'Ver más' : 'View more'}</span>
        <svg class="w-3 h-3 group-hover/link:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
      </a>
    )}
  </div>
</div>
