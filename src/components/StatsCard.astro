---
interface Props {
  value: string;
  label: string;
  gradient?: string;
}

const { value, label, gradient = 'from-cyan-500 to-emerald-500' } = Astro.props;
---

<div class="glass-card-hover p-6 text-center group">
  <div class={`text-3xl md:text-4xl font-bold bg-gradient-to-r ${gradient} bg-clip-text text-transparent mb-1 font-mono`}>
    {value}
  </div>
  <div class="text-sm text-slate-500 group-hover:text-slate-300 transition-colors">
    {label}
  </div>
</div>
