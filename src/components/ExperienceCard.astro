---
import { type Experience} from '../types';
import { type Language } from '../i18n/config';

interface Props {
  experience: Experience;
  lang: Language;
}

const { experience, lang } = Astro.props;

const computeDuration = (startStr: string, endStr: string | null | undefined, lang: Language) => {
  const start = new Date(startStr);
  const end = endStr ? new Date(endStr) : new Date();

  let years = end.getFullYear() - start.getFullYear();
  let months = end.getMonth() - start.getMonth();

  if (months < 0) {
    years--;
    months += 12;
  }

  const parts: string[] = [];
  if (lang === 'es') {
    if (years > 0) parts.push(`${years} ${years === 1 ? 'año' : 'años'}`);
    if (months > 0) parts.push(`${months} ${months === 1 ? 'mes' : 'meses'}`);
    if (parts.length === 0) return 'Menos de un mes';
    return parts.join(' ');
  }

  if (years > 0) parts.push(`${years} ${years === 1 ? 'year' : 'years'}`);
  if (months > 0) parts.push(`${months} ${months === 1 ? 'month' : 'months'}`);
  if (parts.length === 0) return 'Less than a month';
  return parts.join(' ');
};

const duration = computeDuration(experience.startDate, experience.endDate, lang);

const formatDate = (dateStr: string) => {
  const date = new Date(dateStr);
  const months = lang === 'es'
    ? ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre']
    : ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
  return `${months[date.getMonth()]} ${date.getFullYear()}`;
};
---

<div class="glass-card-hover p-6 group">
  <div class="flex flex-col sm:flex-row justify-between items-start gap-3 mb-4">
    <div class="flex-1">
      <div class="flex items-center gap-2 mb-1">
        <div class="w-2 h-2 rounded-full bg-emerald-500"></div>
        <span class="text-[10px] font-mono text-emerald-500 uppercase tracking-wider">{experience.type}</span>
      </div>
      <h3 class="text-lg font-bold text-slate-200 group-hover:text-cyan-300 transition-colors">{experience.position}</h3>
      <p class="text-sm text-cyan-400">{experience.company}</p>
    </div>
  </div>

  <div class="flex flex-wrap gap-2 mb-3 text-xs font-mono text-slate-500">
    <span class="flex items-center gap-1">
      <svg class="w-3.5 h-3.5 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
      {formatDate(experience.startDate)} — {experience.endDate ? formatDate(experience.endDate) : (lang === 'es' ? 'Actualidad' : 'Present')}
    </span>
    <span class="text-slate-700">|</span>
    <span>{duration}</span>
    <span class="text-slate-700">|</span>
    <span class="flex items-center gap-1">
      <svg class="w-3.5 h-3.5 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
      {experience.location}
    </span>
  </div>

  <p class="text-sm text-slate-400 mb-4 leading-relaxed whitespace-pre-line">{experience.description}</p>

  <div class="flex flex-wrap gap-1.5">
    {experience.technologies.map((tech) => (
      <span class="tech-tag">{tech}</span>
    ))}
  </div>
</div>
