---
import { useTranslation, type Language } from '../i18n/config';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslation(lang);

const cv = (await import('../data/cv.json')).default;
const cvData = cv[lang];

const prefix = `/${lang}`;
---

<footer class="bg-[#06060b] border-t border-slate-800/50 py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10 mb-12">
      <!-- Brand -->
      <div class="md:col-span-1">
        <a href={`/${lang}`} class="text-xl font-bold bg-gradient-to-r from-cyan-400 via-emerald-400 to-cyan-300 bg-clip-text text-transparent font-mono">
          ~/ander
        </a>
        <p class="text-sm text-slate-500 mt-4 leading-relaxed">
          {cvData.bio}
        </p>
        <div class="flex gap-3 mt-6">
          <a href={cvData.social.github} target="_blank" rel="noopener noreferrer" class="w-9 h-9 rounded-lg bg-slate-800/50 border border-slate-700/50 flex items-center justify-center text-slate-400 hover:text-cyan-400 hover:border-cyan-500/50 transition-all duration-300">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
          </a>
          <a href={cvData.social.linkedin} target="_blank" rel="noopener noreferrer" class="w-9 h-9 rounded-lg bg-slate-800/50 border border-slate-700/50 flex items-center justify-center text-slate-400 hover:text-cyan-400 hover:border-cyan-500/50 transition-all duration-300">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
          <a href={`mailto:${cvData.social.email}`} class="w-9 h-9 rounded-lg bg-slate-800/50 border border-slate-700/50 flex items-center justify-center text-slate-400 hover:text-cyan-400 hover:border-cyan-500/50 transition-all duration-300">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          </a>
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-sm font-semibold text-slate-300 uppercase tracking-wider mb-5">{t('footer.quick_links')}</h3>
        <ul class="space-y-3 text-sm">
          <li><a href={`/${lang}`} class="text-slate-500 hover:text-cyan-400 transition">{t('nav.home')}</a></li>
          <li><a href={`${prefix}/experiencia`} class="text-slate-500 hover:text-cyan-400 transition">{t('nav.experience')}</a></li>
          <li><a href={`${prefix}/formacion`} class="text-slate-500 hover:text-cyan-400 transition">{t('nav.education')}</a></li>
          <li><a href={`${prefix}/proyectos`} class="text-slate-500 hover:text-cyan-400 transition">{t('nav.projects')}</a></li>
          <li><a href={`${prefix}/contacto`} class="text-slate-500 hover:text-cyan-400 transition">{t('nav.contact')}</a></li>
        </ul>
      </div>

      <!-- Contact Info -->
      <div>
        <h3 class="text-sm font-semibold text-slate-300 uppercase tracking-wider mb-5">{t('nav.contact')}</h3>
        <ul class="space-y-3 text-sm">
          <li class="text-slate-500">{cvData.location}</li>
          <li><a href={`mailto:${cvData.email}`} class="text-slate-500 hover:text-cyan-400 transition">{cvData.email}</a></li>
          <li><a href={cvData.social.github} target="_blank" rel="noopener noreferrer" class="text-slate-500 hover:text-cyan-400 transition">GitHub</a></li>
          <li><a href={cvData.social.linkedin} target="_blank" rel="noopener noreferrer" class="text-slate-500 hover:text-cyan-400 transition">LinkedIn</a></li>
        </ul>
      </div>

      <!-- Newsletter -->
      <div>
        <h3 class="text-sm font-semibold text-slate-300 uppercase tracking-wider mb-5">{t('footer.newsletter')}</h3>
        <p class="text-sm text-slate-500 mb-4 leading-relaxed">
          {lang === 'es' ? 'Mantente al día con mis últimos proyectos.' : 'Stay updated with my latest projects.'}
        </p>
        <form class="flex flex-col gap-2">
          <input type="email" placeholder={t('footer.newsletter_placeholder')} class="input-field text-sm" />
          <button type="submit" class="px-4 py-2 bg-gradient-to-r from-cyan-500 to-emerald-500 text-white text-sm font-semibold rounded-lg hover:shadow-lg hover:shadow-cyan-500/25 transition-all duration-300">
            {t('footer.newsletter_button')}
          </button>
        </form>
      </div>
    </div>

    <div class="border-t border-slate-800/50 pt-8 flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-sm text-slate-600">{t('footer.copyright')}</p>
      <div class="flex gap-6 text-xs text-slate-600">
        <span class="flex items-center gap-1">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          {lang === 'es' ? 'Disponible para proyectos' : 'Available for projects'}
        </span>
      </div>
    </div>
  </div>
</footer>
