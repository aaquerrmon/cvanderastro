---
interface Props {
  name: string;
  percentage: number;
  color?: string;
}

const { name, percentage, color = 'from-cyan-500 to-emerald-500' } = Astro.props;
---

<div class="space-y-1.5">
  <div class="flex justify-between items-center">
    <span class="text-sm text-slate-300 font-medium">{name}</span>
    <span class="text-xs font-mono text-slate-500">{percentage}%</span>
  </div>
  <div class="h-2 bg-slate-800/50 rounded-full overflow-hidden border border-slate-800/50">
    <div
      class={`h-full bg-gradient-to-r ${color} rounded-full transition-all duration-1000`}
      style={`width: ${percentage}%`}
    ></div>
  </div>
</div>
