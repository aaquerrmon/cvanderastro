---
import { type Language } from '../i18n/config';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;

const code = `from langchain.vectorstores import Milvus
from langchain.embeddings import HuggingFaceEmbeddings
from vllm import LLM, SamplingParams

class RAGPipeline:
    """End-to-end RAG system with local LLMs"""
    
    def __init__(self, model_name: str = "mistral-7b"):
        self.embeddings = HuggingFaceEmbeddings(
            model_name="intfloat/e5-mistral-7b-instruct"
        )
        self.vector_store = Milvus(
            collection_name="documents",
            embedding_function=self.embeddings,
            connection_args={"host": "localhost", "port": "19530"}
        )
        self.llm = LLM(model=model_name)
    
    def retrieve(self, query: str, k: int = 5) -> list:
        """Retrieve relevant documents"""
        return self.vector_store.similarity_search(
            query, k=k
        )
    
    def generate(self, query: str, context: list) -> str:
        """Generate response from context"""
        prompt = self._build_prompt(query, context)
        params = SamplingParams(temperature=0.1, max_tokens=1024)
        return self.llm.generate(prompt, params)
    
    async def stream_response(self, query: str):
        """Stream response token by token"""
        context = self.retrieve(query)
        async for token in self.generate(query, context):
            yield token`;
---

<div class="py-20 px-4">
  <div class="max-w-5xl mx-auto">
    <div class="text-center mb-10">
      <span class="font-mono text-xs text-cyan-400 bg-cyan-500/10 px-4 py-1.5 rounded-full border border-cyan-500/20">
        {lang === 'es' ? '// Código en producción' : '// Production code'}
      </span>
    </div>

    <div class="glass-card overflow-hidden shadow-2xl shadow-cyan-500/5">
      <div class="flex items-center justify-between px-4 py-3 bg-slate-900/50 border-b border-slate-800/50">
        <div class="flex items-center gap-2">
          <div class="w-3 h-3 rounded-full bg-red-500/80"></div>
          <div class="w-3 h-3 rounded-full bg-yellow-500/80"></div>
          <div class="w-3 h-3 rounded-full bg-emerald-500/80"></div>
          <span class="text-xs text-slate-600 ml-2 font-mono">rag_pipeline.py — vscode</span>
        </div>
        <div class="flex items-center gap-3 text-xs text-slate-600">
          <span class="hidden sm:inline">Python</span>
          <span class="w-4 h-4 rounded bg-emerald-500/20 text-emerald-400 text-[10px] flex items-center justify-center font-mono">✓</span>
        </div>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full">
          <tbody class="font-mono text-xs md:text-sm leading-[1.8]">
            {code.split('\n').map((line, i) => (
              <tr class="hover:bg-slate-800/30">
                <td class="text-slate-600 text-right pr-4 select-none w-10 text-[10px] align-top pt-0 pb-0">{i + 1}</td>
                <td class="whitespace-pre align-top pt-0 pb-0">
                  {line.startsWith('class') ? (
                    <span class="text-purple-400">class </span>
                  ) : line.startsWith('    """') ? (
                    <span class="text-emerald-500">    """</span>
                  ) : line.startsWith('"""') ? (
                    <span class="text-emerald-500">"""</span>
                  ) : line.includes('"""') ? (
                    <>
                      <span class="text-emerald-500">{line.split('"""')[0]}"""</span>
                    </>
                  ) : line.startsWith('from ') || line.startsWith('import ') ? (
                    <span><span class="text-purple-400">from</span> <span class="text-slate-200">{line.split('from ')[1]?.split(' import ')[0]}</span><span class="text-purple-400"> import</span> <span class="text-slate-200">{line.split(' import ')[1]}</span></span>
                  ) : line.includes('def ') ? (
                    <>
                      <span class="text-slate-500">{line.split('def ')[0]}</span>
                      <span class="text-cyan-400">def</span>
                      <span class="text-yellow-400"> {line.match(/def (\w+)/)?.[1]}</span>
                      <span class="text-slate-200">{line.split(/def \w+/)[1]}</span>
                    </>
                  ) : line.includes('async def ') ? (
                    <>
                      <span class="text-slate-500">{line.split('async def ')[0]}</span>
                      <span class="text-purple-400">async</span>
                      <span class="text-cyan-400"> def</span>
                      <span class="text-yellow-400"> {line.match(/async def (\w+)/)?.[1]}</span>
                      <span class="text-slate-200">{line.split(/async def \w+/)[1]}</span>
                    </>
                  ) : line.includes('self.') ? (
                    <>
                      <span class="text-slate-500">{line.split('self.')[0]}</span>
                      <span class="text-cyan-400">self</span>
                      <span class="text-slate-200">.{line.split('self.')[1]}</span>
                    </>
                  ) : line.includes('return ') ? (
                    <><span class="text-slate-500">{line.split('return ')[0]}</span><span class="text-purple-400">return</span><span class="text-slate-200"> {line.split('return ')[1]}</span></>
                  ) : line.includes('yield ') ? (
                    <><span class="text-slate-500">{line.split('yield ')[0]}</span><span class="text-purple-400">yield</span><span class="text-slate-200"> {line.split('yield ')[1]}</span></>
                  ) : (
                    <span class="text-slate-500">{
                      line
                        .replace(/("(?:[^"\\]|\\.)*")/g, '\x01')
                        .replace(/('(?:[^'\\]|\\.)*')/g, '\x02')
                        .replace(/(\d+\.?\d*)/g, '\x03')
                    }</span>
                  )}
                  {line.includes('"') && (
                    <span class="text-emerald-500">{
                      line.match(/"[^"]*"/g)?.join(' ')
                    }</span>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
