---
import { type Language } from '../i18n/config';

interface Props {
  title: string;
  description: string;
  buttonText: string;
  lang: Language;
}

const { title, description, buttonText, lang } = Astro.props;
const prefix = `/${lang}`;

const blocks = [
  { label: 'CODE', gradient: 'from-cyan-500 to-blue-600' },
  { label: 'EAT', gradient: 'from-emerald-500 to-green-600' },
  { label: 'SLEEP', gradient: 'from-purple-500 to-pink-600' },
  { label: 'REPEAT', gradient: 'from-pink-500 to-rose-600' },
];
---

<section class="py-24 px-4 relative overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-b from-cyan-500/[0.02] to-purple-500/[0.02] pointer-events-none"></div>

  <div class="max-w-4xl mx-auto text-center relative">
    <h2 class="section-title gradient-text">{title}</h2>
    <p class="section-subtitle">{description}</p>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-12 max-w-lg mx-auto">
      {blocks.map((block) => (
        <div class="glass-card-hover p-6 text-center group">
          <div class={`text-xl font-bold bg-gradient-to-r ${block.gradient} bg-clip-text text-transparent font-mono tracking-widest group-hover:scale-110 transition-transform`}>
            {block.label}
          </div>
        </div>
      ))}
    </div>

    <a href={`${prefix}/contacto`} class="btn-primary inline-block">
      {buttonText}
    </a>
  </div>
</section>
